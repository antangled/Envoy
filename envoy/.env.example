# Envoy runs in demo mode with none of these set. Add them to go live.

# AI briefs and drafts (Claude Haiku 5.5, Sonnet 5.5 for re-checks)
ANTHROPIC_API_KEY=
# Company discovery — dashboard.exa.ai, $10/month free credit
EXA_API_KEY=
# Named contacts — hunter.io, 50 free credits/month
HUNTER_API_KEY=

# Gmail sending — Google Cloud OAuth client (Web), consent screen in Testing,
# scopes: openid, email, https://www.googleapis.com/auth/gmail.send
# Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Required in production (dev generates these under .data/)
AUTH_SECRET=            # openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32
CRON_SECRET=            # openssl rand -hex 16

# Optional: hosted Postgres. Without it, an embedded Postgres is stored in .data/pglite
DATABASE_URL=
