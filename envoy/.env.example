# Copy to .env.local and replace each PASTE_..._HERE value, then restart `npm run dev`.
# Any value still shaped like a placeholder is ignored and that feature stays in demo mode.
# .env.local is git-ignored. Never commit real keys.

# AI briefs and drafts — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE
# Only if Anthropic asks for a workspace: Console → Settings → Workspaces → copy the workspace ID
ANTHROPIC_WORKSPACE_ID=PASTE_YOUR_WORKSPACE_ID_HERE

# Companies and people — dashboard.exa.ai → API Keys
EXA_API_KEY=PASTE_YOUR_EXA_KEY_HERE

# Named contacts and emails — hunter.io → API
HUNTER_API_KEY=PASTE_YOUR_HUNTER_KEY_HERE

# Gmail sign-in and sending — Google Cloud Console → Google Auth Platform → Clients (Web application)
# Redirect URI to register: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
APP_URL=http://localhost:3000

# Only needed when deploying (local dev generates these automatically under .data/)
# AUTH_SECRET=            openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=   openssl rand -base64 32
# CRON_SECRET=            openssl rand -hex 16
# DATABASE_URL=           Postgres connection string (Neon or Supabase)
